
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RefillRequestStatus {
  OPEN
  CLAIMED
  PURCHASED
  RECEIPT_SUBMITTED
  COMPLETED
  CANCELLED
}

model Office {
  id             String          @id
  name           String
  country        String
  currency       String          @db.VarChar(3)
  monthlyBudget  Decimal         @db.Decimal(12, 2)
  volunteers     Volunteer[]
  refillRequests RefillRequest[]
}

model Volunteer {
  id               String          @id
  name             String
  email            String          @unique
  officeId         String
  isActive         Boolean         @default(true)

  office           Office          @relation(fields: [officeId], references: [id])
  reportedRequests RefillRequest[] @relation("RequestReporter")
  claimedRequests  RefillRequest[] @relation("RequestClaimant")
}

model RefillRequest {
  id              String              @id
  officeId        String
  reportedBy      String
  description     String
  status          RefillRequestStatus @default(OPEN)
  claimedBy       String?
  claimedAt       DateTime?
  purchasedAt     DateTime?
  receiptReference String?
  purchaseAmount  Decimal?            @db.Decimal(12, 2)
  hrStatus        String?
  hrRemarks       String?
  createdAt       DateTime            @default(now())

  office          Office              @relation(fields: [officeId], references: [id])
  reporter        Volunteer           @relation("RequestReporter", fields: [reportedBy], references: [id])
  claimant        Volunteer?          @relation("RequestClaimant", fields: [claimedBy], references: [id])

  @@index([officeId, status])
  @@index([claimedBy])
}
